# Copie este arquivo para ".env" (na raiz do projeto) e preencha o que tiver.
# Sem NENHUMA chave o sistema roda inteiro: simulador de WhatsApp + IA em modo demo.

# --- IA ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Com a chave da OpenAI, foto, áudio e texto funcionam (a da Anthropic é opcional).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
OPENAI_MODELO_AUDIO=gpt-transcribe

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=escolha-uma-frase-secreta
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_LEMBRETE=lembrete_pano

# --- Segurança do painel ---
# Mínimo de 32 caracteres. Troque antes de usar de verdade.
JWT_SECRET=troque-este-segredo-antes-de-usar-em-producao-0123456789

# --- Banco (PostgreSQL do docker-compose; o perfil "dev" usa H2 e ignora estes) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=panocerto
DB_USER=panocerto
DB_PASSWORD=panocerto

# --- Economia estimada no painel (R$ por hectare por aplicação) ---
CUSTO_APLICACAO_HA=120
